# AMT Solutions — Apache / AeonFree configuration

# 1. CUSTOM ERROR PAGES
# Redirects 404 errors to a file named 404.html in your htdocs root
ErrorDocument 404 /404.html

# 3. DISABLE DIRECTORY BROWSING
# Prevents visitors from seeing your file list if an index.html is missing
Options -Indexes

# 4. DEFAULT INDEX FILE PRIORITY
# Sets which file loads first when someone visits your domain
DirectoryIndex index.php index.html index.htm

<IfModule mod_rewrite.c>
# 2. FORCE HTTPS (SSL)
# Automatically upgrades traffic from http to https
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect /products to /shop
RewriteRule ^products/?$ /shop/ [R=301,L]

# Redirect www to apex. Enable only after both hostnames resolve.
RewriteCond %{HTTP_HOST} ^www\.amtsolutions\.lk$ [NC]
RewriteRule ^ https://amtsolutions.lk%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/avif "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
